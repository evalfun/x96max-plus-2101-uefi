[Defines]
  DEC_SPECIFICATION              = 0x0001001B
  PACKAGE_NAME                   = AmlogicX96MaxPlus
  PACKAGE_GUID                   = 3b81bdf4-9a52-4eb7-8e69-cbe8eaf49270
  PACKAGE_VERSION                = 0.1

[Guids]
  gX96TokenSpaceGuid = { 0x2b8f4c31, 0x7d6a, 0x4e19, { 0x95, 0xc2, 0x0a, 0x77, 0xe3, 0x1b, 0x64, 0xd8 } }
  #
  # Signalled by the boot manager once the boot card's filesystem is
  # connected and the controller churn (USB retry loop) has settled; the
  # persisted variable store is loaded in response, serialized with the
  # rest of the BDS flow instead of racing it.
  #
  gX96NvVarsLoadEventGuid = { 0x5d3a7c41, 0x8b2f, 0x4e6d, { 0x9a, 0xc1, 0x27, 0x64, 0x53, 0x18, 0xf2, 0xe7 } }

[Protocols]
  #
  # Installed by X96NvVarsPersistDxe once a persisted variable store has
  # been restored from the boot card.  Presence tells the boot manager that
  # NVRAM is authoritative (deleted boot entries stay deleted); absence
  # means a virgin store and triggers the fallback boot options.
  #
  gX96NvVarsPersistProtocolGuid = { 0x927ccfcb, 0x92a9, 0x4fc4, { 0xa3, 0xd8, 0x37, 0xea, 0x65, 0x35, 0xde, 0x95 } }
